{
  "name": "leylinebook-dev-tools",
  "private": true,
  "description": "开发期 PWA 单元测试与桌面/手机浏览器回归工具；应用运行时不依赖 npm 包。",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "node --test --test-concurrency=1 tests/*.e2e.js",
    "test:sw": "node --test tests/sw-lifecycle.e2e.js",
    "test:upgrade": "python -B -X utf8 scripts/upgrade_integration.py"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0"
  }
}
